---
import LpcCharacter from '../../components/dungeon/LpcCharacter.astro';

type Slot = 'chest' | 'legs' | 'boots' | 'helmet' | 'weapon' | 'shield';

const players: Array<{
  id: number;
  name: string;
  level: number;
  status: string;
  loadout: Slot[];
}> = [
  {
    id: 1,
    name: 'Player One',
    level: 10,
    status: 'Full loadout',
    loadout: ['chest', 'legs', 'boots', 'helmet', 'weapon', 'shield'],
  },
  {
    id: 2,
    name: 'Player Two',
    level: 8,
    status: 'Armored',
    loadout: ['chest', 'legs', 'boots'],
  },
  {
    id: 3,
    name: 'Player Three',
    level: 7,
    status: 'Armed',
    loadout: ['weapon', 'shield'],
  },
  {
    id: 4,
    name: 'Player Four',
    level: 6,
    status: 'Guarded',
    loadout: ['helmet', 'chest'],
  },
  {
    id: 5,
    name: 'Player Five',
    level: 5,
    status: 'Base body',
    loadout: [],
  },
  {
    id: 6,
    name: 'Player Six',
    level: 4,
    status: 'No shield',
    loadout: ['chest', 'legs', 'boots', 'helmet', 'weapon'],
  },
];

const loadoutFor = (slots: Slot[]) => ({
  chest: slots.includes('chest'),
  legs: slots.includes('legs'),
  boots: slots.includes('boots'),
  helmet: slots.includes('helmet'),
  weapon: slots.includes('weapon'),
  shield: slots.includes('shield'),
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LPC V1 Six-Player Dungeon Room</title>
    <style>
      :root {
        color-scheme: dark;
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
          "Segoe UI", sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        width: 100%;
        min-width: 320px;
        min-height: 100%;
        margin: 0;
        background: transparent;
      }

      body {
        overflow-x: hidden;
        color: #f7ecd0;
      }

      button {
        font: inherit;
      }

      .overlay-shell {
        min-height: 100vh;
        padding: clamp(12px, 1.7vw, 32px);
        display: grid;
        place-items: center;
      }

      .room {
        position: relative;
        isolation: isolate;
        width: min(100%, 1856px);
        min-height: min(1016px, calc(100vh - 32px));
        padding: clamp(16px, 2vw, 36px);
        overflow: hidden;
        border: 2px solid rgba(184, 149, 94, 0.66);
        border-radius: 28px;
        background:
          radial-gradient(
            ellipse at 50% 22%,
            rgba(151, 116, 68, 0.25) 0 15%,
            transparent 42%
          ),
          radial-gradient(
            ellipse at 15% 45%,
            rgba(65, 85, 73, 0.26),
            transparent 33%
          ),
          radial-gradient(
            ellipse at 85% 43%,
            rgba(65, 85, 73, 0.22),
            transparent 31%
          ),
          linear-gradient(
            180deg,
            rgba(7, 9, 10, 0.97) 0 52%,
            rgba(25, 25, 20, 0.97) 52% 100%
          );
        box-shadow:
          inset 0 0 110px rgba(0, 0, 0, 0.9),
          inset 0 -90px 80px rgba(0, 0, 0, 0.42);
      }

      .room::before {
        content: "";
        position: absolute;
        z-index: -2;
        inset: 0;
        opacity: 0.28;
        background:
          linear-gradient(
            115deg,
            transparent 0 14%,
            rgba(174, 146, 99, 0.26) 14.4% 15%,
            transparent 15.4% 35%,
            rgba(174, 146, 99, 0.18) 35.4% 36%,
            transparent 36.4% 68%,
            rgba(174, 146, 99, 0.2) 68.4% 69%,
            transparent 69.4%
          ),
          repeating-linear-gradient(
            0deg,
            transparent 0 72px,
            rgba(201, 171, 116, 0.12) 73px 75px
          );
      }

      .room::after {
        content: "";
        position: absolute;
        z-index: -1;
        left: 3%;
        right: 3%;
        bottom: 2%;
        height: 48%;
        border-radius: 50% 50% 12px 12px;
        background:
          radial-gradient(
            ellipse at center,
            rgba(186, 143, 77, 0.19),
            transparent 64%
          ),
          repeating-linear-gradient(
            93deg,
            rgba(107, 92, 67, 0.13) 0 3px,
            transparent 3px 78px
          );
        transform: perspective(520px) rotateX(56deg);
        transform-origin: bottom;
      }

      .room-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 14px;
      }

      .title-block h1 {
        margin: 0;
        color: #ffe4ae;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(1.25rem, 2vw, 2rem);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        text-shadow: 0 3px 16px #000;
      }

      .title-block p {
        margin: 5px 0 0;
        color: #b9ae98;
        font-size: 0.78rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .state-readout {
        flex: 0 0 auto;
        padding: 7px 12px;
        border: 1px solid rgba(226, 188, 120, 0.34);
        border-radius: 999px;
        background: rgba(8, 10, 10, 0.72);
        color: #efcb88;
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .controls {
        position: relative;
        z-index: 20;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: clamp(14px, 1.6vw, 24px);
        padding: 10px;
        border: 1px solid rgba(169, 142, 98, 0.3);
        border-radius: 13px;
        background: rgba(6, 8, 8, 0.68);
        backdrop-filter: blur(4px);
      }

      .controls button {
        min-height: 36px;
        padding: 7px 12px;
        border: 1px solid rgba(215, 181, 121, 0.36);
        border-radius: 7px;
        background: #171915;
        color: #d9cfbd;
        cursor: pointer;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.025em;
      }

      .controls button:hover,
      .controls button:focus-visible {
        border-color: #e4b865;
        color: #fff1cf;
        outline: none;
      }

      .controls button[aria-pressed="true"] {
        border-color: #d49a42;
        background: #5b3d16;
        color: #fff0c6;
        box-shadow: inset 0 0 0 1px rgba(255, 219, 151, 0.16);
      }

      .control-divider {
        width: 1px;
        margin: 3px 2px;
        background: rgba(215, 181, 121, 0.25);
      }

      .players {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: clamp(14px, 2.2vw, 34px);
      }

      .player-card {
        min-width: 0;
        padding: clamp(12px, 1.4vw, 22px) 12px 13px;
        display: flex;
        flex-direction: column;
        align-items: center;
        border: 1px solid rgba(191, 159, 105, 0.25);
        border-radius: 18px;
        background:
          radial-gradient(
            ellipse at 50% 60%,
            rgba(166, 127, 68, 0.16),
            transparent 56%
          ),
          linear-gradient(180deg, rgba(16, 20, 18, 0.53), rgba(4, 5, 5, 0.68));
        box-shadow:
          inset 0 1px rgba(255, 232, 188, 0.04),
          0 10px 25px rgba(0, 0, 0, 0.2);
      }

      .sprite-stage {
        position: relative;
        width: 224px;
        height: 206px;
        display: grid;
        place-items: center;
      }

      .sprite-stage::after {
        content: "";
        position: absolute;
        left: 26px;
        right: 26px;
        bottom: 8px;
        height: 20px;
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.58);
        filter: blur(3px);
      }

      .sprite-stack {
        position: relative;
        z-index: 1;
        width: 64px;
        height: 64px;
        transform: scale(3);
        transform-origin: center;
      }

      .sprite {
        position: absolute;
        inset: 0;
        width: 64px;
        height: 64px;
        background-image: var(--idle-image);
        background-repeat: no-repeat;
        background-position: 0 -128px;
        image-rendering: pixelated;
        image-rendering: crisp-edges;
      }

      .room[data-state$="-back"] .sprite {
        background-position-y: 0;
      }

      .room[data-state^="walk-"] .sprite {
        background-image: var(--walk-image);
        animation: walk-cycle 900ms steps(9) infinite;
      }

      .equipment-layer {
        transition: opacity 140ms linear;
      }

      .room.all-equipment-hidden .equipment-layer,
      .player-card.equipment-hidden .equipment-layer {
        opacity: 0;
      }

      .player-meta {
        width: min(100%, 300px);
        border-top: 1px solid rgba(218, 184, 124, 0.18);
        padding-top: 9px;
        text-align: center;
      }

      .player-name {
        margin: 0;
        overflow: hidden;
        color: #fff0cb;
        font-size: clamp(0.92rem, 1.15vw, 1.15rem);
        font-weight: 800;
        letter-spacing: 0.045em;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .player-detail {
        margin-top: 5px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: #c1b6a1;
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .level {
        color: #e0b76b;
        font-weight: 800;
      }

      .status {
        padding: 3px 7px;
        border: 1px solid rgba(150, 183, 133, 0.32);
        border-radius: 999px;
        background: rgba(44, 70, 46, 0.28);
        color: #b8d7a9;
      }

      @keyframes walk-cycle {
        to {
          background-position-x: -576px;
        }
      }

      @media (max-width: 980px) {
        .players {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .room {
          min-height: auto;
        }
      }

      @media (max-width: 620px) {
        .overlay-shell {
          padding: 8px;
        }

        .room {
          padding: 13px 9px;
          border-radius: 16px;
        }

        .room-heading {
          align-items: flex-start;
          flex-direction: column;
          gap: 8px;
        }

        .players {
          grid-template-columns: 1fr;
        }

        .sprite-stage {
          height: 200px;
        }

        .control-divider {
          display: none;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .room[data-state^="walk-"] .sprite {
          animation-play-state: paused;
        }

        .equipment-layer {
          transition: none;
        }
      }
    </style>
  </head>
  <body>
    <main class="overlay-shell">
      <section
        class="room"
        id="lpc-room"
        data-state="idle-front"
        aria-labelledby="room-title"
      >
        <header class="room-heading">
          <div class="title-block">
            <h1 id="room-title">The Sixfold Vault</h1>
            <p>Universal LPC V1 · Static room prototype</p>
          </div>
          <output class="state-readout" id="state-readout">Idle Front</output>
        </header>

        <nav class="controls" aria-label="LPC room test controls">
          <button type="button" data-state-control="idle-front" aria-pressed="true">
            Idle Front
          </button>
          <button type="button" data-state-control="idle-back" aria-pressed="false">
            Idle Back
          </button>
          <button type="button" data-state-control="walk-front" aria-pressed="false">
            Walk Front
          </button>
          <button type="button" data-state-control="walk-back" aria-pressed="false">
            Walk Back
          </button>
          <span class="control-divider" aria-hidden="true"></span>
          <button type="button" data-equipment-control="all" aria-pressed="true">
            Toggle All Equipment
          </button>
          <button type="button" data-equipment-control="1" aria-pressed="true">
            Toggle Player 1 Equipment
          </button>
          <button type="button" data-equipment-control="5" aria-pressed="true">
            Toggle Player 5 Equipment
          </button>
        </nav>

        <div class="players" aria-label="Six mock dungeon players">
          {
            players.map((player) => (
              <article class="player-card" data-player-id={player.id}>
                <div class="sprite-stage">
                  <LpcCharacter
                    name={player.name}
                    level={player.level}
                    state="idle"
                    direction="front"
                    scale={3}
                    showName={false}
                    showLevel={false}
                    loadout={loadoutFor(player.loadout)}
                  />
                </div>

                <div class="player-meta">
                  <h2 class="player-name">{player.name}</h2>
                  <div class="player-detail">
                    <span class="level">Level {player.level}</span>
                    <span aria-hidden="true">·</span>
                    <span class="status">{player.status}</span>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </section>
    </main>

    <script>
      const room = document.querySelector<HTMLElement>('#lpc-room');
      const stateReadout =
        document.querySelector<HTMLOutputElement>('#state-readout');
      const stateButtons = Array.from(
        document.querySelectorAll<HTMLButtonElement>('[data-state-control]'),
      );
      const equipmentButtons = Array.from(
        document.querySelectorAll<HTMLButtonElement>('[data-equipment-control]'),
      );

      const stateLabels: Record<string, string> = {
        'idle-front': 'Idle Front',
        'idle-back': 'Idle Back',
        'walk-front': 'Walk Front',
        'walk-back': 'Walk Back',
      };

      stateButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const nextState = button.dataset.stateControl;
          if (!room || !nextState || !(nextState in stateLabels)) return;

          room.dataset.state = nextState;
          stateButtons.forEach((candidate) => {
            candidate.setAttribute(
              'aria-pressed',
              String(candidate === button),
            );
          });

          if (stateReadout) stateReadout.value = stateLabels[nextState];
        });
      });

      equipmentButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const target = button.dataset.equipmentControl;
          if (!room || !target) return;

          let equipmentVisible = true;
          if (target === 'all') {
            room.classList.toggle('all-equipment-hidden');
            equipmentVisible = !room.classList.contains('all-equipment-hidden');
          } else {
            const playerCard = room.querySelector<HTMLElement>(
              `[data-player-id="${target}"]`,
            );
            if (!playerCard) return;
            playerCard.classList.toggle('equipment-hidden');
            equipmentVisible =
              !playerCard.classList.contains('equipment-hidden');
          }

          button.setAttribute('aria-pressed', String(equipmentVisible));
        });
      });
    </script>
  </body>
</html>
